      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 0\n1 0\n7 0\n8 1\n4294967295 536870911\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 0\n1 0\n7 0\n8 1\n4294967295 536870911\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 0\n1 0\n7 0\n8 1\n4294967295 536870911\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 0\n1 0\n7 0\n8 1\n4294967295 536870911\n"
        }
      }
    }
