  {
    "id": "p2_divide_u32",
    "family": "literal_casts_limits",
    "a": "fn f(x:u32)->u32{x/8} fn main(){let v:[u32;5]=[0,1,7,8,u32::MAX];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}}",
    "b": "fn f(x:u32)->u32{x>>3} fn main(){let v:[u32;5]=[0,1,7,8,u32::MAX];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}}",
    "expected": "same",
