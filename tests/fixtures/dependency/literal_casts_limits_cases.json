  {
    "id": "signed_divide",
    "family": "literal_casts_limits",
    "a": "fn f(x:i32)->i32{x/2} fn main(){let v:[i32;4]=[-3,-1,0,3];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}}",
    "b": "fn f(x:i32)->i32{x>>1} fn main(){let v:[i32;4]=[-3,-1,0,3];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-3 -1\n-1 0\n0 0\n3 1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-3 -1\n-1 0\n0 0\n3 1\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-3 -2\n-1 -1\n0 0\n3 1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-3 -2\n-1 -1\n0 0\n3 1\n"
        }
      }
    }
  },
