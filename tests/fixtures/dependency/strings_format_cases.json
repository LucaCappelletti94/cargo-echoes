[
  {
    "id": "sf_empty_to_string",
    "family": "strings_format",
    "a": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(\"\".to_string());}",
    "b": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(String::new());}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"\" 0 0\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"\" 0 0\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"\" 0 0\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"\" 0 0\n"
        }
      }
    }
  },
