      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"<x{y>\" 5 5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"<x{y>\" 5 5\n"
        }
      }
    }
