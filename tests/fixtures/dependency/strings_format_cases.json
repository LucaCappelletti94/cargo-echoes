  {
    "id": "sf_println_inline",
    "family": "strings_format",
    "a": "fn main(){let n=3;println!(\"{} {} {}\",\"a}\",n,\"z\");}",
    "b": "fn main(){let n=3;println!(\"a}} {n} z\");}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "a} 3 z\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "a} 3 z\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "a} 3 z\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "a} 3 z\n"
        }
      }
    }
  },
  {
    "id": "sf_format_capture",
    "family": "strings_format",
    "a": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(format!(\"{}\", 5));}",
    "b": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(5.to_string());}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"5\" 1 1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"5\" 1 1\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"5\" 1 10\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"5\" 1 10\n"
        }
      }
    }
  },
  {
    "id": "sf_debug_literal",
    "family": "strings_format",
    "a": "fn main(){println!(\"{:?}\",\"hi\");}",
    "b": "fn main(){println!(\"hi\");}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"hi\"\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"hi\"\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "hi\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "hi\n"
        }
      }
    }
  }
