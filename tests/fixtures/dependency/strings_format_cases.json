  {
    "id": "sf_format_literal",
    "family": "strings_format",
    "a": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(format!(\"abc\"));}",
    "b": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(\"abc\".to_string());}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"abc\" 3 3\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"abc\" 3 3\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"abc\" 3 3\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"abc\" 3 3\n"
        }
      }
    }
  },
  {
    "id": "sf_format_braces",
    "family": "strings_format",
    "a": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(format!(\"a{{b}}\"));}",
    "b": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(\"a{b}\".to_string());}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a{b}\" 4 4\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a{b}\" 4 4\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a{b}\" 4 4\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a{b}\" 4 4\n"
        }
      }
    }
  },
  {
    "id": "sf_format_inline",
    "family": "strings_format",
    "a": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(format!(\"<{}>\", \"x{y\"));}",
    "b": "fn show(s:String){println!(\"{:?} {} {}\",s,s.len(),s.capacity());} fn main(){show(\"<x{y>\".to_string());}",
