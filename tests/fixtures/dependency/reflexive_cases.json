[
  {
    "id": "r_bool",
    "family": "reflexive",
    "a": "fn f(x:bool)->bool{x==x} fn main(){for x in [false,true]{println!(\"{}\",f(x));}}",
    "b": "fn f(x:bool)->bool{true} fn main(){for x in [false,true]{println!(\"{}\",f(x));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        }
      }
    }
  },
