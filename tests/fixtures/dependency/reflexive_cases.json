    "b": "fn f(x:u32)->bool{true} fn main(){std::panic::set_hook(Box::new(|_|{}));println!(\"{}\",f(0));}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "",
          "exit": 101
        },
        "on": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "",
          "exit": 101
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\n"
        }
      }
    }
  },
