  {
    "id": "r_effectful_calls",
    "family": "reflexive",
    "a": "use std::sync::atomic::{AtomicU32,Ordering}; static N:AtomicU32=AtomicU32::new(0); fn read()->u32{N.fetch_add(1,Ordering::SeqCst)} fn f()->bool{read()==read()} fn main(){println!(\"{} {}\",f(),N.load(Ordering::SeqCst));}",
    "b": "use std::sync::atomic::{AtomicU32,Ordering}; static N:AtomicU32=AtomicU32::new(0); fn read()->u32{N.fetch_add(1,Ordering::SeqCst)} fn f()->bool{true} fn main(){println!(\"{} {}\",f(),N.load(Ordering::SeqCst));}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 2\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 2\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true 0\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true 0\n"
        }
      }
    }
  },
  {
    "id": "r_partial_division",
