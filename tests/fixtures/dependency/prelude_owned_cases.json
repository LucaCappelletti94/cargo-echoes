  {
    "id": "po_to_owned",
    "family": "prelude_owned",
    "a": "fn f()->String{\"abc\".to_owned()} fn main(){let s=f();s.chars().for_each(|c|print!(\"{}\",c));println!(\" {} {}\",s.len(),s.capacity()>=s.len());}",
    "b": "fn f()->String{\"abc\".to_string()} fn main(){let s=f();s.chars().for_each(|c|print!(\"{}\",c));println!(\" {} {}\",s.len(),s.capacity()>=s.len());}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc 3 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc 3 true\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc 3 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc 3 true\n"
        }
      }
    }
  },
