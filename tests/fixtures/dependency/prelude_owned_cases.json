  {
    "id": "po_local_string",
    "family": "prelude_owned",
    "a": "struct String; impl String{fn from(_:&str)->u32{7}} fn main(){println!(\"{}\",String::from(\"abc\"));}",
    "b": "struct String; impl String{fn from(_:&str)->u32{7}} fn main(){println!(\"{}\",\"abc\".to_string());}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "7\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "7\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc\n"
        }
      }
    }
  },
  {
    "id": "po_user_trait",
    "family": "prelude_owned",
    "a": "trait Owned{fn to_owned(&self)->u32;} impl Owned for str{fn to_owned(&self)->u32{7}} fn main(){println!(\"{}\",\"abc\".to_owned());}",
    "b": "trait Owned{fn to_owned(&self)->u32;} impl Owned for str{fn to_owned(&self)->u32{7}} fn main(){println!(\"{}\",\"abc\".to_string());}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": [
            "E0034"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "E0034"
          ],
          "run": "absent"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "abc\n"
        }
      }
    }
  },
