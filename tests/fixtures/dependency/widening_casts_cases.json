  {
    "id": "wc_sign_change",
    "family": "widening_casts",
    "a": "fn f(x:i32)->u64{x as u64} fn main(){for x in [-1i32,5]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "b": "fn f(x:i32)->u64{(x as u32) as u64} fn main(){for x in [-1i32,5]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "expected": "different",
