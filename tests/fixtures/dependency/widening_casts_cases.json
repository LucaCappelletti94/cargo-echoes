  {
    "id": "wc_narrowing",
    "family": "widening_casts",
    "a": "fn f(x:u32)->u16{x as u16} fn main(){for x in [70000u32,5]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "b": "fn f(x:u32)->u16{u16::try_from(x).unwrap_or(0)} fn main(){for x in [70000u32,5]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "4464\n5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "4464\n5\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n5\n"
        }
      }
    }
  },
  {
    "id": "wc_shadowed_target",
    "family": "widening_casts",
    "a": "#[allow(non_camel_case_types)] struct u64(u32); impl From<u32> for u64{fn from(x:u32)->Self{u64(x+1)}} fn main(){println!(\"{}\",u64::from(std::hint::black_box(3u32)).0);}",
    "b": "#[allow(non_camel_case_types)] struct u64(u32); impl From<u32> for u64{fn from(x:u32)->Self{u64(x+1)}} fn main(){println!(\"{}\",(std::hint::black_box(3u32) as u64).0);}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "4\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "4\n"
        }
      },
      "b": {
        "off": {
          "compile": [
            "E0605"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "E0605"
          ],
          "run": "absent"
        }
      }
    }
  }
