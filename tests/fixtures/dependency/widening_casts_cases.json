[
  {
    "id": "wc_u8_u16",
    "family": "widening_casts",
    "a": "fn f(x:u8)->u16{x as u16} fn main(){for x in [0u8,1,255]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "b": "fn f(x:u8)->u16{u16::from(x)} fn main(){for x in [0u8,1,255]{println!(\"{}\",f(std::hint::black_box(x)));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n1\n255\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n1\n255\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n1\n255\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n1\n255\n"
        }
      }
    }
  },
