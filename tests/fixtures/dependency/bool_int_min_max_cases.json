    "b": "fn f(x:u8,y:u8)->u8{x.max(y)} fn main(){for (x,y) in [(0u8,255u8),(255u8,0u8),(7u8,7u8),(3u8,4u8)]{println!(\"{} {} {}\",x,y,f(x,y));}}",
