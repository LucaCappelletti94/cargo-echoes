        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 255 255\n255 0 255\n7 7 7\n3 4 4\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 255 255\n255 0 255\n7 7 7\n3 4 4\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 255 255\n255 0 255\n7 7 7\n3 4 4\n"
        }
      }
