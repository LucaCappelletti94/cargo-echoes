  {
    "id": "bi_cast",
    "family": "bool_int_min_max",
    "a": "fn f(p:bool)->u32{if p {1u32} else {0u32}} fn main(){for p in [false,true]{println!(\"{} {}\",p,f(p));}}",
    "b": "fn f(p:bool)->u32{p as u32} fn main(){for p in [false,true]{println!(\"{} {}\",p,f(p));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 0\ntrue 1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 0\ntrue 1\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 0\ntrue 1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 0\ntrue 1\n"
        }
      }
    }
  },
