  {
    "id": "c_byte_string",
    "family": "concat",
    "a": "fn f()->&'static str{concat!(b\"a\")} fn main(){println!(\"{:?}\",f());}",
    "b": "fn f()->&'static str{\"a\"} fn main(){println!(\"{:?}\",f());}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": [
            "cannot concatenate a byte string literal"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "cannot concatenate a byte string literal"
          ],
          "run": "absent"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a\"\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"a\"\n"
        }
      }
    }
  }
