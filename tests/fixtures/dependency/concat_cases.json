[
  {
    "id": "c_pair",
    "family": "concat",
    "a": "fn f()->&'static str{concat!(\"a\",\"b\")} fn main(){println!(\"{:?}\",f());}",
    "b": "fn f()->&'static str{\"ab\"} fn main(){println!(\"{:?}\",f());}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"ab\"\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"ab\"\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"ab\"\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "\"ab\"\n"
        }
      }
    }
  },
