  {
    "id": "dj_guard",
    "family": "literal_disjunctions",
    "a": "fn main(){let v:[u32;3]=[1,2,3];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}} fn f(x:u32)->bool{matches!(x,1|2 if x>1)}",
    "b": "fn main(){let v:[u32;3]=[1,2,3];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}} fn f(x:u32)->bool{x==1||x==2}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 false\n2 true\n3 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 false\n2 true\n3 false\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 true\n2 true\n3 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 true\n2 true\n3 false\n"
        }
      }
    }
  },
  {
    "id": "dj_call_scrutinee",
    "family": "literal_disjunctions",
    "a": "use std::cell::Cell; thread_local!{static N:Cell<u32>=Cell::new(0);} fn next()->u32{N.with(|n|{n.set(n.get()+1);n.get()})} fn main(){let a=matches!(next(),2|3);println!(\"{} {}\",a,next());}",
    "b": "use std::cell::Cell; thread_local!{static N:Cell<u32>=Cell::new(0);} fn next()->u32{N.with(|n|{n.set(n.get()+1);n.get()})} fn main(){let a=next()==2||next()==3;println!(\"{} {}\",a,next());}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 2\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 2\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 3\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false 3\n"
        }
      }
    }
  }
