[
  {
    "id": "dj_or_u32",
    "family": "literal_disjunctions",
    "a": "fn main(){let v:[u32;5]=[0,1,2,3,u32::MAX];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}} fn f(x:u32)->bool{matches!(x,1|2)}",
    "b": "fn main(){let v:[u32;5]=[0,1,2,3,u32::MAX];for x in v{println!(\"{} {}\",x,f(std::hint::black_box(x)));}} fn f(x:u32)->bool{x==1||x==2}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n2 true\n3 false\n4294967295 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n2 true\n3 false\n4294967295 false\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n2 true\n3 false\n4294967295 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n2 true\n3 false\n4294967295 false\n"
        }
      }
    }
  },
