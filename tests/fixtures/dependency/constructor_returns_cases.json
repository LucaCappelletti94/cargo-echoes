  {
    "id": "cr_ok_unit",
    "family": "constructor_returns",
    "a": "struct D(&'static str); impl Drop for D{fn drop(&mut self){println!(\"drop {}\",self.0);}} fn f(x:&mut u32)->Result<(),u8>{let _l=D(\"local\");*x+=1;return Ok(());} fn main(){let mut x=1;println!(\"{:?} {}\",f(&mut x),x);}",
    "b": "struct D(&'static str); impl Drop for D{fn drop(&mut self){println!(\"drop {}\",self.0);}} fn f(x:&mut u32)->Result<(),u8>{let _l=D(\"local\");*x+=1;Ok(())} fn main(){let mut x=1;println!(\"{:?} {}\",f(&mut x),x);}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "drop local\nOk(()) 2\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "drop local\nOk(()) 2\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "drop local\nOk(()) 2\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "drop local\nOk(()) 2\n"
        }
      }
    }
  },
