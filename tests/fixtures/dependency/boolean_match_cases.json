[
  {
    "id": "b_bool_pair",
    "family": "boolean_match",
    "a": "fn f(p:bool,x:bool,y:bool)->bool{match p{true=>x,false=>y}} fn main(){for p in [false,true]{println!(\"{}\",f(p,true,false));}}",
    "b": "fn f(p:bool,x:bool,y:bool)->bool{if p{x}else{y}} fn main(){for p in [false,true]{println!(\"{}\",f(p,true,false));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\n"
        }
      }
    }
  },
