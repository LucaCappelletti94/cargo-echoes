[
  {
    "id": "ac_string_index",
    "family": "collection_accessors",
    "a": "fn f(s: String) -> usize { let t: &str = &s[..]; t.len() } fn main(){ println!(\"{:?} {:?}\", f(String::from(\"abc\")), f(String::new())); }",
    "b": "fn f(s: String) -> usize { let t: &str = s.as_str(); t.len() } fn main(){ println!(\"{:?} {:?}\", f(String::from(\"abc\")), f(String::new())); }",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 0\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 0\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 0\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 0\n"
        }
      }
    }
  },
