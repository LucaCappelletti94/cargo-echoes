  {
    "id": "bl_condition_effect",
    "family": "boolean_literal",
    "a": "fn read()->u32{println!(\"read\");7u32} fn f(p:bool,x:u32,y:u32)->u32{let _=y;if p!=true{read()}else{x}} fn main(){for p in [false,true]{println!(\"{}\",f(p,1u32,2u32));}}",
    "b": "fn read()->u32{println!(\"read\");7u32} fn f(p:bool,x:u32,y:u32)->u32{let _=y;if !p{read()}else{x}} fn main(){for p in [false,true]{println!(\"{}\",f(p,1u32,2u32));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "read\n7\n1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "read\n7\n1\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "read\n7\n1\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "read\n7\n1\n"
        }
      }
    }
  },
  {
    "id": "bl_ungrouped_negation",
    "family": "boolean_literal",
    "a": "fn f(p:bool,q:bool)->bool{(p&q)==false} fn main(){for p in [false,true]{for q in [false,true]{println!(\"{}\",f(p,q));}}}",
    "b": "fn f(p:bool,q:bool)->bool{!p&q} fn main(){for p in [false,true]{for q in [false,true]{println!(\"{}\",f(p,q));}}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\nfalse\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\nfalse\nfalse\n"
        }
      }
    }
  },
