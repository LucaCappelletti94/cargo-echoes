[
  {
    "id": "bl_eq_false",
    "family": "boolean_literal",
    "a": "fn f(p:bool)->bool{p==false} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "b": "fn f(p:bool)->bool{!p} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\nfalse\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\nfalse\n"
        }
      }
    }
  },
