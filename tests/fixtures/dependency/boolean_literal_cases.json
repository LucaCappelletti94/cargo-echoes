  {
    "id": "bl_conjunction",
    "family": "boolean_literal",
    "a": "fn f(p:bool,q:bool)->bool{(p&&q)!=true} fn main(){for p in [false,true]{for q in [false,true]{println!(\"{}\",f(p,q));}}}",
    "b": "fn f(p:bool,q:bool)->bool{!p||!q} fn main(){for p in [false,true]{for q in [false,true]{println!(\"{}\",f(p,q));}}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\ntrue\nfalse\n"
        }
      }
    }
  },
