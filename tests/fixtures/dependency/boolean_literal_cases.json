  {
    "id": "bl_custom_equality",
    "family": "boolean_literal",
    "a": "struct S; impl PartialEq<bool> for S{fn eq(&self,_:&bool)->bool{true}} fn f(p:bool)->bool{let _=p;S==false} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "b": "struct S; impl PartialEq<bool> for S{fn eq(&self,_:&bool)->bool{true}} fn f(p:bool)->bool{let _=p;!S} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "true\ntrue\n"
        }
      },
      "b": {
        "off": {
          "compile": [
            "E0600"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "E0600"
          ],
          "run": "absent"
        }
      }
    }
  }
