[
  {
    "id": "fs_print",
    "family": "format_spellings",
    "a": "fn main() { let x = 3; let y = \"z\"; print!(\"{} {}\\n\", x, y); print!(\"\\n\"); println!(\"end\"); }",
    "b": "fn main() { let x = 3; let y = \"z\"; println!(\"{} {}\", x, y); println!(); println!(\"end\"); }",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 z\n\nend\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 z\n\nend\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 z\n\nend\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "3 z\n\nend\n"
        }
      }
    }
  },
  {
    "id": "fs_write",
    "family": "format_spellings",
    "a": "use std::io::Write; fn main() { let mut w: Vec<u8> = Vec::new(); write!(w, \"{:>4}\\n\", 7).unwrap(); writeln!(w, \"\").unwrap(); write!(w, \"{{x}}\\n\").unwrap(); println!(\"{:?}\", w); }",
    "b": "use std::io::Write; fn main() { let mut w: Vec<u8> = Vec::new(); writeln!(w, \"{:>4}\", 7).unwrap(); writeln!(w).unwrap(); writeln!(w, \"{{x}}\").unwrap(); println!(\"{:?}\", w); }",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "[32, 32, 32, 55, 10, 10, 123, 120, 125, 10]\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "[32, 32, 32, 55, 10, 10, 123, 120, 125, 10]\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "[32, 32, 32, 55, 10, 10, 123, 120, 125, 10]\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "[32, 32, 32, 55, 10, 10, 123, 120, 125, 10]\n"
        }
      }
    }
  },
