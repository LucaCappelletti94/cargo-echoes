  {
    "id": "fs_double_newline",
    "family": "format_spellings",
    "a": "fn main() { print!(\"a\\n\\n\"); println!(\"end\"); }",
    "b": "fn main() { println!(\"a\"); println!(\"end\"); }",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "a\n\nend\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "a\n\nend\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "a\nend\n"
