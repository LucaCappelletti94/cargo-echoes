  {
    "id": "bi_dyn_order",
    "family": "bounds_impl_lifetimes",
    "a": "fn f(x:Box<dyn Sync+Send>)->usize{std::mem::size_of_val(&x)} fn g(x:&(dyn std::fmt::Debug+Send))->String{format!(\"{:?}\",x)} fn main(){let b:Box<dyn Sync+Send>=Box::new(5u8);println!(\"{} {}\",f(b),g(&7u8));}",
    "b": "fn f(x:Box<dyn Send+Sync>)->usize{std::mem::size_of_val(&x)} fn g(x:&(dyn Send+std::fmt::Debug))->String{format!(\"{:?}\",x)} fn main(){let b:Box<dyn Send+Sync>=Box::new(5u8);println!(\"{} {}\",f(b),g(&7u8));}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "16 7\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "16 7\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "16 7\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "16 7\n"
        }
      }
    }
  },
