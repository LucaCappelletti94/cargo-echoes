  {
    "id": "lg_partial_order",
    "family": "boolean_logic",
    "a": "fn f(p:bool,x:u32,y:u32)->bool{x/y>0u32&&p} fn main(){std::panic::set_hook(Box::new(|_|{}));for p in [false,true]{println!(\"{}\",f(p,4u32,0u32));}}",
    "b": "fn f(p:bool,x:u32,y:u32)->bool{p&&x/y>0u32} fn main(){std::panic::set_hook(Box::new(|_|{}));for p in [false,true]{println!(\"{}\",f(p,4u32,0u32));}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "",
          "exit": 101
        },
        "on": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "",
          "exit": 101
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "false\n",
          "exit": 101
        },
        "on": {
          "compile": "ok",
          "run": "diverge",
          "stdout": "false\n",
          "exit": 101
        }
      }
    }
