  {
    "id": "lg_commuted_comparison_u32",
    "family": "boolean_logic",
    "a": "fn f(p:bool,x:u32,y:u32)->bool{x<y&&p} fn main(){for p in [false,true]{for (x,y) in [(1u32,2u32),(2,2),(3,2)]{println!(\"{}\",f(p,x,y));}}}",
    "b": "fn f(p:bool,x:u32,y:u32)->bool{p&&x<y} fn main(){for p in [false,true]{for (x,y) in [(1u32,2u32),(2,2),(3,2)]{println!(\"{}\",f(p,x,y));}}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\nfalse\nfalse\ntrue\nfalse\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\nfalse\nfalse\ntrue\nfalse\nfalse\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\nfalse\nfalse\ntrue\nfalse\nfalse\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\nfalse\nfalse\ntrue\nfalse\nfalse\n"
        }
      }
    }
