  {
    "id": "lg_and_true",
    "family": "boolean_logic",
    "a": "fn f(p:bool)->bool{p&&true} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "b": "fn f(p:bool)->bool{p} fn main(){for p in [false,true]{println!(\"{}\",f(p));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "false\ntrue\n"
