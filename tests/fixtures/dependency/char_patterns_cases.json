  {
    "id": "pc_two_chars",
    "family": "char_patterns",
    "a": "fn f(s: &str) -> Vec<&str> { s.split(\"ab\").collect() } fn main(){ println!(\"{:?}\", f(\"xabyaz\")); }",
    "b": "fn f(s: &str) -> Vec<&str> { s.split('a').collect() } fn main(){ println!(\"{:?}\", f(\"xabyaz\")); }",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "[\"x\", \"yaz\"]\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "[\"x\", \"yaz\"]\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "[\"x\", \"by\", \"z\"]\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "[\"x\", \"by\", \"z\"]\n"
        }
      }
    }
  }
