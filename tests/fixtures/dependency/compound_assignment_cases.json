[
  {
    "id": "ca_add_u32",
    "family": "compound_assignment",
    "a": "fn f(mut x:u32,y:u32)->u32{x+=y;x} fn main(){std::panic::set_hook(Box::new(|_|{}));for (x,y) in [(4294967295u32,1u32),(7,0),(12,40),(9,3)]{match std::panic::catch_unwind(||f(x,y)){Ok(v)=>println!(\"{}\",v),Err(e)=>println!(\"panic {:?}\",e.downcast_ref::<&str>())}}}",
    "b": "fn f(mut x:u32,y:u32)->u32{x=x+y;x} fn main(){std::panic::set_hook(Box::new(|_|{}));for (x,y) in [(4294967295u32,1u32),(7,0),(12,40),(9,3)]{match std::panic::catch_unwind(||f(x,y)){Ok(v)=>println!(\"{}\",v),Err(e)=>println!(\"panic {:?}\",e.downcast_ref::<&str>())}}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n7\n52\n12\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "panic Some(\"attempt to add with overflow\")\n7\n52\n12\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0\n7\n52\n12\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "panic Some(\"attempt to add with overflow\")\n7\n52\n12\n"
        }
      }
    }
  },
