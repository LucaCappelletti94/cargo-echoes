    "a": "fn main(){println!(\"{:?}\",(f(true),f(false)));} fn f(p:bool)->u32{if p{1}else{0}}",
    "b": "fn main(){println!(\"{:?}\",(f(true),f(false)));} fn f(p:bool)->u32{p as u32}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "(1, 0)\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "(1, 0)\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "(1, 0)\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "(1, 0)\n"
        }
      }
    }
  },
