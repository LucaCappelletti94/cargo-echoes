[
  {
    "id": "rt_tail_arithmetic",
    "family": "return_literal_typing",
    "a": "fn main(){println!(\"{:?}\",f());} fn f()->u32{2+3}",
    "b": "fn main(){println!(\"{:?}\",f());} fn f()->u32{5u32}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "5\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "5\n"
        }
      }
    }
  },
  {
