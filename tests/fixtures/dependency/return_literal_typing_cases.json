  {
    "id": "rt_impl_trait",
    "family": "return_literal_typing",
    "a": "fn main(){println!(\"{:?}\",f());} fn f()->impl std::fmt::Debug{3000000000}",
    "b": "fn main(){println!(\"{:?}\",f());} fn f()->impl std::fmt::Debug{3000000000u32}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": [
            "literal out of range for `i32`"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "literal out of range for `i32`"
          ],
          "run": "absent"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "3000000000\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "3000000000\n"
        }
      }
    }
  },
  {
    "id": "rt_shadowed_alias",
    "family": "return_literal_typing",
    "a": "fn main(){println!(\"{:?}\",f());} type u32=u8; fn f()->u32{255}",
    "b": "fn main(){println!(\"{:?}\",f());} type u32=u8; fn f()->u32{255u32}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "255\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "255\n"
        }
      },
      "b": {
        "off": {
          "compile": [
            "E0308"
          ],
          "run": "absent"
        },
        "on": {
          "compile": [
            "E0308"
          ],
          "run": "absent"
        }
      }
    }
