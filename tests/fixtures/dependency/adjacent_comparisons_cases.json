  {
    "id": "ac_signed_zero",
    "family": "adjacent_comparisons",
    "a": "fn f(x:i32)->bool{x>0} fn main(){for x in [-1i32,0i32,1i32]{println!(\"{} {}\",x,f(x));}}",
    "b": "fn f(x:i32)->bool{x!=0} fn main(){for x in [-1i32,0i32,1i32]{println!(\"{} {}\",x,f(x));}}",
    "expected": "different",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-1 false\n0 false\n1 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-1 false\n0 false\n1 true\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-1 true\n0 false\n1 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-1 true\n0 false\n1 true\n"
        }
      }
    }
  },
