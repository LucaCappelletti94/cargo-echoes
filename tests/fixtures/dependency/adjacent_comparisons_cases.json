[
  {
    "id": "ac_upper_u8",
    "family": "adjacent_comparisons",
    "a": "fn f(x:u8)->bool{x<=254} fn main(){for x in [0u8,1u8,253u8,254u8,255u8]{println!(\"{} {}\",x,f(x));}}",
    "b": "fn f(x:u8)->bool{x<255} fn main(){for x in [0u8,1u8,253u8,254u8,255u8]{println!(\"{} {}\",x,f(x));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 true\n1 true\n253 true\n254 true\n255 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 true\n1 true\n253 true\n254 true\n255 false\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 true\n1 true\n253 true\n254 true\n255 false\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 true\n1 true\n253 true\n254 true\n255 false\n"
        }
      }
    }
  },
  {
    "id": "ac_lower_i8",
    "family": "adjacent_comparisons",
    "a": "fn f(x:i8)->bool{x>=-127i8} fn main(){for x in [-128i8,-127i8,-1i8,0i8,127i8]{println!(\"{} {}\",x,f(x));}}",
    "b": "fn f(x:i8)->bool{x>-128i8} fn main(){for x in [-128i8,-127i8,-1i8,0i8,127i8]{println!(\"{} {}\",x,f(x));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-128 false\n-127 true\n-1 true\n0 true\n127 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-128 false\n-127 true\n-1 true\n0 true\n127 true\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "-128 false\n-127 true\n-1 true\n0 true\n127 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "-128 false\n-127 true\n-1 true\n0 true\n127 true\n"
        }
      }
    }
  },
