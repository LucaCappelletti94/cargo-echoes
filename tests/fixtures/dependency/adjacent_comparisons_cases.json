  {
    "id": "ac_unsigned_nonzero",
    "family": "adjacent_comparisons",
    "a": "fn f(x:u32)->bool{x>=1} fn main(){for x in [0u32,1u32,4294967295u32]{println!(\"{} {}\",x,f(x));}}",
    "b": "fn f(x:u32)->bool{x!=0} fn main(){for x in [0u32,1u32,4294967295u32]{println!(\"{} {}\",x,f(x));}}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n4294967295 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n4294967295 true\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n4294967295 true\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "0 false\n1 true\n4294967295 true\n"
        }
      }
    }
  },
