          "run": "value",
          "stdout": "1 2 5\n"
        }
      },
      "b": {
        "off": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 2 5\n"
        },
        "on": {
          "compile": "ok",
          "run": "value",
          "stdout": "1 2 5\n"
        }
      }
    }
