    "b": "fn f(x:&u32)->&u32{x} fn hr<G:for<'x> Fn(&'x u32)->&'x u32>(g:G)->u32{*g(&5)} fn main(){let p:fn(&u32)->&u32=f;let q:for<'x> fn(&'x u32)->&'x u32=f;println!(\"{} {} {}\",p(&1),q(&2),hr(f));}",
    "expected": "same",
    "expect": {
      "a": {
        "off": {
          "compile": "ok",
