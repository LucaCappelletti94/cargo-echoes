#!/usr/bin/env bash
# Fixture gh for the action smoke harness, replaying scenario API responses.
# Every call is logged to $FAKE_LOG/gh.jsonl with its parameters, and a
# body=@- stdin body is stored under $FAKE_LOG for inspection.
set -uo pipefail
log_dir="${FAKE_LOG:?}"
case "${1:-}" in
  api)
    shift
    path=''; method=GET; jqexpr=''; args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -X) method="$2"; shift 2 ;;
        -f|-F) args+=("$2"); shift 2 ;;
        --jq) jqexpr="$2"; shift 2 ;;
        --paginate) shift ;;
        *) path="$1"; shift ;;
      esac
    done
    # A real gh api treats field arguments as a post, the fake mirrors it.
    [ "${#args[@]}" -gt 0 ] && [ "$method" = "GET" ] && method=POST
    has_stdin=0; stdin_body=''
    for a in "${args[@]:-}"; do
      [ "$a" = "body=@-" ] && { stdin_body="$(cat)"; has_stdin=1; }
    done
    # The value of a field argument may span lines, so each argument is logged
    # through its own jq pass instead of one newline-split pass.
    params_json='{}'
    for a in "${args[@]:-}"; do
      if [ -n "$a" ] && [ "$a" != "body=@-" ]; then
        params_json="$(jq -c --arg k "${a%%=*}" --arg v "${a#*=}" '. + {($k): $v}' <<< "$params_json")"
      fi
    done
    body_file=''
    if [ "$has_stdin" = "1" ]; then
      n="$(ls "$log_dir"/gh-call-*.md 2>/dev/null | wc -l | tr -d ' ')"
      body_file="gh-call-$n.md"
      printf '%s' "$stdin_body" > "$log_dir/$body_file"
      params_json="$(jq -c --arg f "body=$body_file" '. + {body: $f}' <<< "$params_json")"
    fi
    jq -cn --arg m "$method" --arg p "$path" --argjson params "$params_json" --arg j "$jqexpr" \
      '{m: $m, p: $p, params: $params, j: $j}' >> "$log_dir/gh.jsonl"
    resp='{}'
    case "$path" in
      "repos/$GITHUB_REPOSITORY/pulls/"*"/files")
        if [ -n "${SCEN_CHANGED_FILES:-}" ] && [ -f "${SCEN_CHANGED_FILES:-}" ]; then
          resp="$(jq -Rcs 'split("\n") | map(select(length > 0)) | map({filename: .})' < "$SCEN_CHANGED_FILES")"
        else
          resp='[]'
        fi
        ;;
      "repos/$GITHUB_REPOSITORY/pulls?"*)
        # The listing filters by the head label like the real api.
        head="${path#*head=}"
        head="${head%%&*}"
        head="${head//%3A/:}"
        resp="$(jq -c --arg h "$head" '[.[] | select(.head.label == $h)]' "${SCEN_OPEN_PRS:?}")"
        ;;
      "repos/$GITHUB_REPOSITORY/pulls/"*)
        case "$method" in
          POST)
            if [ "${SCEN_GH_403:-0}" = "1" ]; then
              echo '{"message":"Resource not accessible by integration","documentation_url":"https://docs.github.com/rest"}'
              echo "gh: Resource not accessible by integration (HTTP 403)" >&2
              exit 1
            fi
            case "$path" in
              */comments)
                if [ -n "${SCEN_GH_FAIL:-}" ]; then
                  echo "{\"message\":\"Failed\",\"status\":\"$SCEN_GH_FAIL\"}"
                  echo "gh: Failed (HTTP $SCEN_GH_FAIL)" >&2
                  exit 1
                fi
                # The comment posts beyond the allowed count hit a secondary rate limit.
                if [ -n "${SCEN_GH_RATELIMIT:-}" ]; then
                  n="$(cat "$log_dir/gh-comments-done" 2>/dev/null || echo 0)"
                  n=$((n + 1))
                  printf '%s' "$n" > "$log_dir/gh-comments-done"
                  if [ "$n" -gt "${SCEN_GH_RATELIMIT:-0}" ]; then
                    echo '{"message":"You have exceeded a secondary rate limit. Please wait a few minutes before you retry making this request.","documentation_url":"https://docs.github.com/rest/overview/rate-limits-for-the-github-api"}'
                    echo "gh: You have exceeded a secondary rate limit. Please wait a few minutes before you retry making this request. (HTTP 403)" >&2
                    exit 1
                  fi
                fi
                resp='{"id": 4242}'
                ;;
              */reviews)
                ev=CHANGES_REQUESTED
                for a in "${args[@]:-}"; do case "$a" in event=*) ev="${a#event=}";; esac; done
                case "$ev" in
                  REQUEST_CHANGES) ev=CHANGES_REQUESTED ;;
                  *) ev=COMMENTED ;;
                esac
                resp="$(jq -cn --arg s "$ev" '{state: $s}')"
                ;;
              *) resp='{}' ;;
            esac
            ;;
          *)
            resp="$(jq -cn --arg b "${SCEN_BASE_SHA:-0000000000000000000000000000000000000000}" \
              --arg h "${SCEN_HEAD_SHA:-0000000000000000000000000000000000000000}" \
              '{base: {sha: $b}, head: {sha: $h}}')"
            ;;
        esac
        ;;
      "repos/"*"releases"*)
        resp='[]'
        ;;
      *)
        resp='{}'
        ;;
    esac
    if [ -n "$jqexpr" ]; then
      printf '%s' "$resp" | jq -r "$jqexpr"
    else
      printf '%s\n' "$resp"
    fi
    ;;
  release)
    echo "fake gh: no release assets" >&2
    exit 1
    ;;
  *)
    echo "fake gh: unhandled command ${1:-<none>}" >&2
    exit 3
    ;;
esac
